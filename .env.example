# Backend (backend/main.py)
ADMIN_USER=admin
ADMIN_PASS=replace-me-with-a-strong-secret
# В prod — фактические домены через запятую; в dev — "*" или http://localhost:3001
FRONTEND_ORIGIN=*

# Frontend (Vite, опционально — только если фронт и бэк на разных доменах)
# В одно-доменной развёртке (nginx reverse proxy) оставить пустым — фронт пойдёт по /api/perf.
# VITE_API_URL=https://api.example.com/api/perf

# Включить session-replay (mousemove sampling) — по умолчанию выключен в prod
# VITE_REPLAY=1
